# Copy to .env and fill in. See docs/specs/02-backend-srv-dev-01.md.

# Postgres (async SQLAlchemy URL)
DATABASE_URL=postgresql+asyncpg://shaddy:shaddy@postgres:5432/shaddy

# Supabase — used to verify the JWTs the SPA sends on writes.
SUPABASE_URL=https://<project-ref>.supabase.co
# RS256 (new projects, JWKS-verified) or HS256 (legacy, shared secret)
SUPABASE_JWT_ALG=RS256
# Only needed when SUPABASE_JWT_ALG=HS256
SUPABASE_JWT_SECRET=

# Comma-separated allowed browser origins (the Vercel app + local dev)
CORS_ORIGINS=https://shaddy.vercel.app,http://localhost:5181,http://localhost:5173

# Where thumbnail PNGs are written on disk (served by Caddy)
THUMBS_DIR=/data/thumbs

# Public origin of this API (used to build absolute thumbnail URLs)
PUBLIC_BASE_URL=https://api.example.com
